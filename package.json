{
  "name": "fleet-v3",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "fleet": "./src/cli.ts"
  },
  "scripts": {
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --type-aware --max-warnings 0 src e2e",
    "typecheck": "tsc --noEmit",
    "knip": "knip --treat-config-hints-as-errors",
    "deps": "depcruise src e2e",
    "test:e2e": "node --test e2e/*.test.ts",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run knip && bun run deps && bun run test:e2e"
  },
  "dependencies": {
    "@vercel/board": "^0.56.1",
    "yaml": "^2.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "dependency-cruiser": "^18.7.0",
    "knip": "^6.42.1",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2008",
    "typescript": "^5.8.3"
  }
}
